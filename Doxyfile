# Doxyfile for RoguelikeLib & RTUI

PROJECT_NAME           = "RoguelikeLib & RTUI"
PROJECT_BRIEF          = "Independent C++20 Roguelike Algorithms and Terminal UI Libraries"
OUTPUT_DIRECTORY       = build/docs

# Input settings
INPUT                  = docs roguelikelib rtui
FILE_PATTERNS          = *.cppm *.h *.hpp *.cpp *.md
RECURSIVE              = YES
USE_MDFILE_AS_MAINPAGE = docs/mainpage.md
EXCLUDE_PATTERNS       = */build/* */.xmake/* */.git/* */tests/* */demo-*/*

# Extraction settings
EXTRACT_ALL            = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
WARN_IF_UNDOCUMENTED   = NO
SOURCE_BROWSER         = YES

# HTML output and Doxygen Awesome CSS theme
GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_FILE_EXTENSION    = .html
HTML_COLORSTYLE        = LIGHT
HTML_HEADER            = docs/theme/header.html
HTML_EXTRA_STYLESHEET  = docs/theme/doxygen-awesome.css \
                         docs/theme/doxygen-awesome-sidebar-only.css \
                         docs/theme/doxygen-awesome-sidebar-only-darkmode-toggle.css
HTML_EXTRA_FILES       = docs/theme/doxygen-awesome-darkmode-toggle.js \
                         docs/theme/doxygen-awesome-fragment-copy-button.js \
                         docs/theme/doxygen-awesome-interactive-toc.js \
                         docs/theme/doxygen-awesome-tabs.js

GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
FULL_SIDEBAR           = NO

# Disable unused outputs
GENERATE_LATEX         = NO
GENERATE_MAN           = NO
GENERATE_RTF           = NO
GENERATE_XML           = NO
